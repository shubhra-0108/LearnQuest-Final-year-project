# ============================================================
# LearnQuest — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/learnquest
MONGO_PASSWORD=learnquest_dev

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_min_32_characters_long
COOKIE_SECRET=change_me_cookie_secret_min_32_chars

# Encryption for UPI IDs (AES-256 needs exactly 32 bytes / 64 hex chars)
CRYPTO_KEY=change_me_exactly_32_bytes_long!!

# ML Service
ML_URL=http://localhost:8001
ML_API_KEY=dev_ml_api_key_change_in_prod

# Admin credentials (used only by seed script)
ADMIN_EMAIL=admin@learnquest.org
ADMIN_PASSWORD=Admin@LearnQuest2024!

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional: AI question generation (OpenAI-compatible)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
